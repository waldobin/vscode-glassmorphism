  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#7E8B9B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.control.from",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#635885"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.template",
        "punctuation.definition.string",
        "string.quoted.double",
        "string.quoted.single"
      ],
      "settings": {
        "foreground": "#376D4B"
      }
    },
    {
      "name": "Functions, Methods, Calls & Macros",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "meta.function-call.generic",
        "meta.method-call entity.name.function",
        "support.function",
        "support.function.macro",
        "entity.name.function.macro",
        "variable.function",
        "keyword.operator.macro"
      ],
      "settings": {
        "foreground": "#286A84"
      }
    },
    {
      "name": "Types, Classes, Structs & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.type.struct",
        "entity.name.type.enum",
        "entity.name.type.interface",
        "entity.name.type.alias",
        "entity.name.type.rust",
        "entity.name.class",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "storage.type.built-in",
        "support.type.primitive"
      ],
      "settings": {
        "foreground": "#744DA3"
      }
    },
    {
      "name": "Properties, Struct Fields & Object Keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "entity.name.variable.field",
        "meta.object-literal.key",
        "variable.object.property"
      ],
      "settings": {
        "foreground": "#9A6218"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "entity.name.variable.parameter",
        "meta.parameters variable"
      ],
      "settings": {
        "foreground": "#476582"
      }
    },
    {
      "name": "Numbers & Numeric Constants",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float"
      ],
      "settings": {
        "foreground": "#B25028"
      }
    },
    {
      "name": "Language Constants & Booleans",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.character",
        "variable.other.constant",
        "entity.name.variable.enum-member"
      ],
      "settings": {
        "foreground": "#B25028"
      }
    },
    {
      "name": "Variables & Default Identifiers",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#2B3342"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#5E6977"
      }
    },
    {
      "name": "Brackets & Parentheses",
      "scope": [
        "punctuation.brackets",
        "punctuation.definition.parameters"
      ],
      "settings": {
        "foreground": "#6C798A"
      }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "meta.tag.jsx",
        "meta.tag.tsx"
      ],
      "settings": {
        "foreground": "#376D4B"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#635885"
      }
    },
    {
      "name": "YAML, JSON & TOML Keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml",
        "meta.map.key.yaml",
        "meta.map.key.yaml string",
        "meta.map.key.yaml string.unquoted.plain.yaml entity.name.tag.yaml",
        "meta.flow.map.key.yaml",
        "meta.flow.map.key.yaml string",
        "meta.flow.map.key.yaml string.unquoted.plain.in.yaml entity.name.tag.yaml",
        "support.type.property-name.yaml",
        "support.type.property-name.toml",
        "entity.name.tag.toml",
        "variable.other.property.toml",
        "keyword.key.toml"
      ],
      "settings": {
        "foreground": "#635885"
      }
    },
    {
      "name": "YAML Strings & Scalar Values",
      "scope": [
        "string.unquoted.plain.out.yaml",
        "string.unquoted.plain.in.yaml",
        "string.unquoted.block.yaml",
        "string.quoted.single.yaml",
        "string.quoted.double.yaml",
        "string.quoted.single.basic.line.toml",
        "string.quoted.single.literal.line.toml",
        "string.quoted.triple.basic.block.toml",
        "string.quoted.triple.literal.block.toml",
        "string.quoted.toml"
      ],
      "settings": {
        "foreground": "#376D4B"
      }
    },
    {
      "name": "YAML & TOML Constants & Booleans",
      "scope": [
        "constant.language.boolean.yaml",
        "constant.language.null.yaml",
        "constant.numeric.integer.decimal.yaml",
        "constant.numeric.float.yaml",
        "constant.numeric.yaml",
        "constant.language.boolean.toml",
        "constant.numeric.integer.toml",
        "constant.numeric.float.toml",
        "constant.numeric.bin.toml",
        "constant.numeric.hex.toml",
        "constant.numeric.oct.toml",
        "constant.numeric.toml",
        "constant.other.time.date.toml",
        "constant.other.time.datetime.local.toml",
        "constant.other.time.datetime.offset.toml",
        "constant.other.time.time.toml"
      ],
      "settings": {
        "foreground": "#B25028"
      }
    },
    {
      "name": "YAML Anchors, Aliases & TOML Headers",
      "scope": [
        "variable.other.anchor.yaml",
        "variable.other.alias.yaml",
        "keyword.control.flow.anchor.yaml",
        "keyword.control.flow.alias.yaml",
        "punctuation.definition.anchor.yaml",
        "punctuation.definition.alias.yaml",
        "support.type.property-name.table.toml",
        "support.type.property-name.array.toml",
        "punctuation.definition.table.toml",
        "punctuation.definition.array.table.toml",
        "entity.other.attribute-name.table.toml",
        "table.header.toml"
      ],
      "settings": {
        "foreground": "#744DA3",
        "fontStyle": "bold"
      }
    },
    {
      "name": "YAML & TOML Punctuation & Separators",
      "scope": [
        "punctuation.separator.key-value.mapping.yaml",
        "punctuation.separator.map.value.yaml",
        "punctuation.separator.mapping.yaml",
        "punctuation.definition.block.sequence.item.yaml",
        "entity.other.document.begin.yaml",
        "entity.other.document.end.yaml",
        "punctuation.eq.toml",
        "punctuation.separator.table.inline.toml",
        "punctuation.separator.array.toml",
        "punctuation.separator.dot.toml"
      ],
      "settings": {
        "foreground": "#5E6977"
      }
    },
    {
      "name": "Regular Expressions",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#9A6218"
      }
    },
    {
      "name": "Vue, Angular & Framework Directives",
      "scope": [
        "entity.other.attribute-name.directive.vue",
        "entity.other.attribute-name.html.angular",
        "entity.other.attribute-name.ng-binding",
        "meta.directive.vue",
        "punctuation.definition.template-expression.vue"
      ],
      "settings": {
        "foreground": "#286A84"
      }
    },
    {
      "name": "XML & Android Manifest Attributes",
      "scope": [
        "entity.other.attribute-name.xml",
        "entity.other.attribute-name.namespace.xml"
      ],
      "settings": {
        "foreground": "#635885"
      }
    }
  ]
}
